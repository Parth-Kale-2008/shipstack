# Caddy terminates HTTPS for the dashboard (shipzo.tech) and every app (<slug>.shipzo.tech).
# Certificates are issued on demand, only for hosts ShipStack confirms exist.
{
	email {{EMAIL}}
	on_demand_tls {
		ask http://127.0.0.1:8080/internal/tls-check
	}
}

https:// {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy 127.0.0.1:8080
}

http:// {
	redir https://{host}{uri} permanent
}
