[Unit]
Description=ShipStack deployment platform
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
User=shipstack
Group=shipstack
EnvironmentFile=/etc/shipstack.env
WorkingDirectory=/opt/shipstack
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
